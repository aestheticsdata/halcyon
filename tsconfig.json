{
  "compilerOptions": {
    // No `baseUrl`: it is deprecated, and without it every `paths` target is resolved
    // relative to this file — hence the leading `./`, which is load-bearing. Dropping it
    // does not fail loudly, it just stops resolving the alias.
    //
    // The same aliases are declared again in vite.config.js, which resolves them itself
    // with path.resolve and is unaffected by this. Add to both or the build breaks.
    "paths": {
      "@animations/*": ["./src/animations/*"],
      "@app/*": ["./src/app/*"],
      "@camera/*": ["./src/camera/*"],
      "@primitives/*": ["./src/primitives/*"],
      "@data/*": ["./src/data/*"],
      "@img/*": ["./src/img/*"],
      "@input/*": ["./src/input/*"],
      "@textures/*": ["./src/textures/*"],
      "@rendering/*": ["./src/rendering/*"],
      "@scene/*": ["./src/scene/*"],
      "@ui/*": ["./src/ui/*"],
      // Not mirrored in vite.config.js, and the only alias that is not: nothing
      // under e2e/ is bundled. Playwright resolves it from this file when it
      // runs the demo harness, and tsc when `pnpm run typecheck` covers it.
      "@e2e/*": ["./e2e/*"]
    },
    "module": "ESNext",
    // `node` is TypeScript's node10 algorithm, deprecated and removed in TS 7. Vite is a
    // bundler, so `bundler` is the mode that actually describes how this project resolves.
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "e2e", "vite-env.d.ts"]
}
